# ---------------------------------------------------------------
# Local development only. Copy to .env and never commit .env.
# On Render, set BRAWL_STARS_API_KEY in the service's
# Environment tab (render.yaml marks it as sync: false, so it is
# never stored in the repo).
# ---------------------------------------------------------------

# Official Brawl Stars Developer API key (https://developer.brawlstars.com)
# 1. Register and click "Create New Key"
# 2. Add Render's outbound IP(s) to "Allowed IP Addresses" (see RENDER.md)
# 3. Paste the token below
BRAWL_STARS_API_KEY=""

# Local port (Render sets PORT automatically in production)
PORT=3000
